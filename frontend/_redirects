# One public content item has one crawlable URL. Netlify serves clean URLs, so
# legacy .html aliases are permanent redirects rather than duplicate 200 pages.
/index.html                         /                         301!
/:lang/index.html                   /:lang/                   301!
/features.html                      /features                 301!
/:lang/features.html                /:lang/features           301!
/document-summary.html              /document-summary         301!
/:lang/document-summary.html        /:lang/document-summary   301!
/lecture-video-summary.html         /lecture-video-summary    301!
/:lang/lecture-video-summary.html   /:lang/lecture-video-summary 301!
/quiz-flashcards.html               /quiz-flashcards          301!
/:lang/quiz-flashcards.html         /:lang/quiz-flashcards    301!
/plans.html                         /plans                    301!
/:lang/plans.html                   /:lang/plans              301!
/about.html                         /about                    301!
/:lang/about.html                   /:lang/about              301!
/contact.html                       /contact                  301!
/:lang/contact.html                 /:lang/contact            301!
/privacy.html                       /privacy                  301!
/:lang/privacy.html                 /:lang/privacy            301!
/terms.html                         /terms                    301!
/:lang/terms.html                   /:lang/terms              301!
/distance-sales.html                /distance-sales           301!
/:lang/distance-sales.html          /:lang/distance-sales     301!
/cookies.html                       /cookies                  301!
/:lang/cookies.html                 /:lang/cookies            301!
/refund.html                        /refund                   301!
/:lang/refund.html                  /:lang/refund             301!

/tr             /               301!
/tr/*           /:splat         301!
# Existing locale index files handle their own trailing slash. A forced
# /en -> /en/ rule also matches /en/ on Netlify and redirects to itself.
/en/*           /:splat         200
/de/*           /:splat         200
/fr/*           /:splat         200
/es/*           /:splat         200
/it/*           /:splat         200
/pt/*           /:splat         200
/ru/*           /:splat         200
/ar/*           /:splat         200
/zh/*           /:splat         200
/ja/*           /:splat         200
/ko/*           /:splat         200
/hi/*           /:splat         200
