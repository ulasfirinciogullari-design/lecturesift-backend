# Copy to /etc/lecturesift/postgres.env on the VPS and chmod 600.
# This file is intentionally separate so the database container receives no
# application, payment, email, social-media, or object-storage credentials.

POSTGRES_DB=lecturesift
# Bootstrap/maintenance owner. The official image creates POSTGRES_USER as a
# superuser, so applications must never use this identity.
POSTGRES_USER=lecturesift_owner
POSTGRES_PASSWORD=
# Least-privilege login used only by the internet-facing API.
LECTURESIFT_APP_DB_USER=lecturesift_app
LECTURESIFT_APP_DB_PASSWORD=
# Separate processing login. It reaches only masked entitlement views plus
# the narrowly writable usage, guest-reservation and runtime-metric paths.
LECTURESIFT_WORKER_DB_USER=lecturesift_worker
LECTURESIFT_WORKER_DB_PASSWORD=
