# Copy only this master template to /etc/lecturesift/runtime.env on the VPS and
# chmod 600. Never commit the populated file and never mount it into a
# container. Production preflight atomically derives root-only api.env,
# worker.env and instagram.env files with deploy/generate_role_envs.py.
# The file is read by both Docker Compose and Bash maintenance scripts. Quote
# values containing spaces, #, $, quotes, or other shell metacharacters.

DATABASE_URL=postgresql+psycopg://lecturesift_app:CHANGE_ME_APP_PASSWORD@postgres:5432/lecturesift
# This source-only value is rewritten to DATABASE_URL in worker.env and is
# deliberately excluded from api.env.
LECTURESIFT_WORKER_DATABASE_URL=postgresql+psycopg://lecturesift_worker:CHANGE_ME_WORKER_PASSWORD@postgres:5432/lecturesift
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_URL=redis://redis:6379/0

PUBLIC_BASE_URL=https://api.lecturesift.com
FRONTEND_BASE_URL=https://lecturesift.com
LECTURESIFT_REQUIRE_POSTGRES=true
LECTURESIFT_REQUIRE_DURABLE_PROCESSING=true
# off: normal service; drain: block new writes but keep signed payment
# callbacks; freeze: expose health checks only during the final data cutover.
LECTURESIFT_MAINTENANCE_MODE=off
# Never exceed LECTURESIFT_JOB_TTL_SECONDS; config also enforces this cap.
LECTURESIFT_CELERY_VISIBILITY_TIMEOUT_SECONDS=21600
LECTURESIFT_WORK_DIR=/var/lib/lecturesift

# Processing limits and bounded parallelism for the 4-vCPU / 8-GB VPS.
LECTURESIFT_MAX_VIDEO_BYTES=1073741824
LECTURESIFT_MAX_SOURCE_FILES=24
LECTURESIFT_MAX_DOCUMENT_BYTES=104857600
LECTURESIFT_MAX_DOCUMENT_PAGES=500
LECTURESIFT_MAX_DOCUMENT_CHARACTERS=1500000
LECTURESIFT_DOCUMENT_WORDS_PER_CREDIT_MINUTE=200
LECTURESIFT_JOB_TTL_SECONDS=21600
# Host-side safety budgets. The start/reload preflight preserves 10 GiB of
# emergency disk plus one 8 GiB job workspace and one maximum-size upload.
# These are byte counts, not application plan entitlements.
LECTURESIFT_HOST_DISK_RESERVE_BYTES=10737418240
LECTURESIFT_MAX_JOB_WORK_BYTES=8589934592
LECTURESIFT_MAX_API_WORKSPACE_BYTES=3221225472
LECTURESIFT_MAX_WORKER_WORKSPACE_BYTES=12884901888
LECTURESIFT_TRANSCRIPTION_PARALLELISM=4
LECTURESIFT_MEDIA_PREP_PARALLELISM=2
LECTURESIFT_SLIDE_ANALYSIS_PARALLELISM=2
LECTURESIFT_SLIDE_EXPORT_PARALLELISM=2
LECTURESIFT_TRANSLATION_PARALLELISM=3
LECTURESIFT_STUDY_PACK_PARALLELISM=3
LECTURESIFT_SOURCE_DOWNLOAD_PARALLELISM=4
LECTURESIFT_STORAGE_TRANSFER_PARALLELISM=4
LECTURESIFT_STORAGE_FILE_TRANSFER_CONCURRENCY=2
LECTURESIFT_DURATION_PROBE_PARALLELISM=4
LECTURESIFT_ARTIFACT_EXPORT_PARALLELISM=3
LECTURESIFT_PRECISE_TRANSCRIPT_TIMESTAMPS=false

# OCR is local to the worker. Do not raise these values without a memory test.
LECTURESIFT_OCR_ENABLED=true
LECTURESIFT_OCR_COMMAND=tesseract
LECTURESIFT_OCR_DPI=200
LECTURESIFT_OCR_MAX_PAGES=150
LECTURESIFT_OCR_PARALLELISM=2
LECTURESIFT_OCR_PAGE_TIMEOUT_SECONDS=45
LECTURESIFT_OCR_MIN_NATIVE_CHARACTERS=24
LECTURESIFT_OCR_ESTIMATED_WORDS_PER_PAGE=400

OPENAI_API_KEY=
BILLING_SESSION_SECRET=
# Migration-only SHA-256 digest of the previous implicit database-URL session
# secret. Remove no later than 14 days after the final cutover.
BILLING_LEGACY_SESSION_SECRET_HEX=
# Stable key for order-scoped payment-token digests. Never rotate it while a
# Checkout Form or protected bank transfer can still be pending.
PAYMENT_TOKEN_BINDING_SECRET=
# During a deliberate rotation, keep the previous raw binding key here only
# through the maximum provider pending/retry window, then remove it.
PAYMENT_TOKEN_BINDING_LEGACY_SECRET=
ADMIN_ADMIN=
BILLING_PROTECTED_EMAILS=

S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ADMIN_TOKEN=
INSTAGRAM_GRAPH_API_VERSION=v23.0
INSTAGRAM_DAILY_AUTOMATION_ENABLED=true
INSTAGRAM_DAILY_MEDIA_TYPE=REELS

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://api.iyzipay.com
IYZICO_BANK_TRANSFER_ENABLED=
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=true
PAYTR_DEBUG=false

EMAIL_PROVIDER=resend
EMAIL_FROM=
LECTURESIFT_OPS_ALERT_EMAIL=
RESEND_API_KEY=
CONTACT_EMAIL=support@lecturesift.com
BILLING_SUPPORT_EMAIL=support@lecturesift.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

BILLING_BANK_IBAN=
BILLING_BANK_ACCOUNT_HOLDER=
BILLING_BANK_NAME=
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_OPERATOR_COUNTRY=TR
LEGAL_OPERATOR_PHONE=
LEGAL_OPERATOR_EMAIL=support@lecturesift.com
LEGAL_TAX_ID=
LEGAL_TAX_OFFICE=
LEGAL_REGISTRATION_ID=
LEGAL_MERSIS_ID=
LEGAL_TRADE_REGISTRY=
LEGAL_KEP_ADDRESS=
LEGAL_CHAMBER_NAME=

# Product rollout, analytics, advertisements, and the public house campaign.
LECTURESIFT_GUEST_TRIAL_MINUTES=5
LECTURESIFT_INSTAGRAM_BONUS_MINUTES=30
LECTURESIFT_ACCOUNT_ACTIVITY_RETENTION_DAYS=180
LECTURESIFT_ANALYTICS_ENABLED=false
LECTURESIFT_GA_MEASUREMENT_ID=
LECTURESIFT_GOOGLE_ADS_ID=
LECTURESIFT_GOOGLE_ADS_SIGNUP_LABEL=
LECTURESIFT_GOOGLE_ADS_PURCHASE_LABEL=
LECTURESIFT_DISPLAY_ADS_ENABLED=false
LECTURESIFT_DISPLAY_AD_UNIT_PATH=
LECTURESIFT_ADSENSE_PUBLISHER_ID=ca-pub-7608481350058806
LECTURESIFT_REWARDED_ADS_ENABLED=false
LECTURESIFT_REWARDED_AD_UNIT_PATH=
LECTURESIFT_REWARDED_AD_MINUTES_PER_VIEW=1
LECTURESIFT_REWARDED_AD_DAILY_LIMIT_MINUTES=3
LECTURESIFT_SITE_BANNER_ENABLED=true
LECTURESIFT_SITE_BANNER_TITLE='Derslerini daha hızlı çalış'
LECTURESIFT_SITE_BANNER_TEXT='Quiz, bilgi kartı, akıllı özet ve daha fazla işleme dakikası için planları keşfet.'
LECTURESIFT_SITE_BANNER_CTA='Planları incele'
LECTURESIFT_SITE_BANNER_URL=/plans.html

# Recovery flags stay false until the corresponding independent checks pass.
LECTURESIFT_DATABASE_RECOVERY_CONFIRMED=false
LECTURESIFT_OBJECT_RETENTION_CONFIRMED=false
LECTURESIFT_RECOVERY_DRILL_CONFIRMED=false

# Cost fields are planning inputs, not invoices. Mark confirmed only after the
# matching supplier invoice has been checked.
LECTURESIFT_COST_USD_TRY_FALLBACK=42
LECTURESIFT_COST_RENDER_MONTHLY_USD=0
LECTURESIFT_COST_RENDER_CONFIRMED=false
LECTURESIFT_COST_NETLIFY_MONTHLY_USD=20
LECTURESIFT_COST_NETLIFY_CONFIRMED=false
LECTURESIFT_COST_RESEND_MONTHLY_USD=0
LECTURESIFT_COST_RESEND_CONFIRMED=false
LECTURESIFT_COST_DOMAIN_ANNUAL_USD=0
LECTURESIFT_COST_DOMAIN_CONFIRMED=false
LECTURESIFT_COST_OTHER_MONTHLY_USD=0
LECTURESIFT_COST_OTHER_CONFIRMED=false
