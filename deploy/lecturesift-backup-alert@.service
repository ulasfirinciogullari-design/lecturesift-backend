[Unit]
Description=Alert on LectureSift production backup failure (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=LECTURESIFT_ENV_FILE=/etc/lecturesift/runtime.env
ExecStart=/bin/bash /opt/lecturesift/deploy/backup_failure_alert.sh %i
TimeoutStartSec=60
UMask=0077
