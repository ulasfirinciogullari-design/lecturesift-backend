# Dedicated non-production Cloudflare R2 resources. Never reuse runtime.env
# bucket or token values. Literal inequality alone is not accepted: the exact
# rehearsal performs a live, read-only positive control on this bucket and
# requires list/read attempts against the production bucket to return an
# explicit authorization denial. Install as /etc/lecturesift/rehearsal.env
# root:root 0600.
LECTURESIFT_REHEARSAL_S3_ENDPOINT_URL=https://REHEARSAL_ACCOUNT_ID.eu.r2.cloudflarestorage.com
LECTURESIFT_REHEARSAL_S3_REGION=auto
LECTURESIFT_REHEARSAL_S3_BUCKET=lecturesift-rehearsal
LECTURESIFT_REHEARSAL_S3_ACCESS_KEY_ID=REPLACE_WITH_REHEARSAL_ONLY_ACCESS_KEY
LECTURESIFT_REHEARSAL_S3_SECRET_ACCESS_KEY=REPLACE_WITH_REHEARSAL_ONLY_SECRET_KEY

# Required for an exact release admission and must not equal the production
# OpenAI key. If omitted, document/OCR diagnostics may still run, but the
# explicit AI skips make that result permanently ineligible for admission.
# LECTURESIFT_REHEARSAL_OPENAI_API_KEY=REPLACE_WITH_REHEARSAL_ONLY_OPENAI_KEY

# Optional format-run controls; no other keys are accepted.
# Diagnostic runs only; selecting a subset makes the result ineligible for
# production admission. Use these case-family names (the default runs all):
# LECTURESIFT_REHEARSAL_FORMAT_CASES=native_documents,ocr_images,mp3_audio,mp4_video
# LECTURESIFT_REHEARSAL_FORMAT_TIMEOUT_SECONDS=1800
