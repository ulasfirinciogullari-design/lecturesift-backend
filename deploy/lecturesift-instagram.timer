[Unit]
Description=Run the LectureSift Instagram studio and replies every 15 minutes

[Timer]
# Same cadence as the Render cron: each slot (carousel from 13:00, Reel from
# 20:00 Europe/Istanbul) publishes once per day and the other runs answer
# comments and DMs. A run still in progress makes the next tick a no-op.
OnCalendar=*-*-* *:00/15:00 UTC
Persistent=true
RandomizedDelaySec=60
AccuracySec=1min

[Install]
WantedBy=timers.target
