[Unit]
Description=Publish LectureSift Instagram content and answer comments and DMs

[Timer]
# Every 15 minutes. Publishing is idempotent per day and slot (Reel from 11:00, carousel from
# 19:00 Europe/Istanbul), so most runs only answer new comments and DMs.
OnCalendar=*-*-* *:00/15:00
Persistent=true
RandomizedDelaySec=60
AccuracySec=1min

[Install]
WantedBy=timers.target
